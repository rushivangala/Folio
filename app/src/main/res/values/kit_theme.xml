<?xml version="1.0" encoding="utf-8"?>
<!-- Window theme shared by the suite. The web UI repaints the bars with the chosen app theme;
     these colours only cover the first frame (Paper in light mode, Gruvbox in dark mode). -->
<resources>
    <color name="kit_window">#f4efe5</color>
    <bool name="kit_light_bars">true</bool>
    <style name="Theme.Kit" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/kit_window</item>
        <item name="android:colorBackground">@color/kit_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/kit_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/kit_light_bars</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowSplashScreenBackground">@color/kit_window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
    <!-- Translucent window for sheets that float over another app (e.g. "Calculate" from selected text). -->
    <style name="Theme.Kit.Sheet" parent="Theme.Kit">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
    <!-- Full-screen black surface for the video player. -->
    <style name="Theme.Kit.Black" parent="Theme.Kit">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
